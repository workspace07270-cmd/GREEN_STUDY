package dto;

public class EmpDTO {

	private int emp_no;
	private String emp_name;
	private String dept;
	private String position;
	private int salary;
	private String hire_date;
	private String email;

	public EmpDTO(int emp_no, String emp_name, String dept, String position, int salary, String hire_date,
			String email) {
		super();
		this.emp_no = emp_no;
		this.emp_name = emp_name;
		this.dept = dept;
		this.position = position;
		this.salary = salary;
		this.hire_date = hire_date;
		this.email = email;
	}package controller;

import java.io.IOException;

import dto.EmpDTO;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import service.EmpService;
import view.ModelAndView;

public class EmpWriteController implements Controller {

    @Override
    public ModelAndView execute(HttpServletRequest request, HttpServletResponse response)
            throws IOException {

        // 1. 한글처리
        request.setCharacterEncoding("UTF-8");

        // 2. 파라미터 받기
        String emp_name = request.getParameter("emp_name");
        String dept = request.getParameter("dept");
        String position = request.getParameter("position");
        int salary = Integer.parseInt(request.getParameter("salary"));
        String hire_date = request.getParameter("hire_date");
        String email = request.getParameter("email");

        // 3. DTO 생성
        EmpDTO dto = new EmpDTO();
        dto.setEmp_name(emp_name);
        dto.setDept(dept);
        dto.setPosition(position);
        dto.setSalary(salary);
        dto.setHire_date(hire_date);
        dto.setEmail(email);

        // 4. Service 호출 (등록)
        EmpService service = EmpService.getInstance();
        service.insertEmp(dto);

        // 5. 목록으로 redirect
        return new ModelAndView("emp_list.do", true);
    }
}
	public int getEmp_no() {
		return emp_no;
	}

	public void setEmp_no(int emp_no) {
		this.emp_no = emp_no;
	}

	public String getEmp_name() {
		return emp_name;
	}

	public void setEmp_name(String emp_name) {
		this.emp_name = emp_name;
	}

	public String getDept() {
		return dept;
	}

	public void setDept(String dept) {
		this.dept = dept;
	}

	public String getPosition() {
		return position;
	}

	public void setPosition(String position) {
		this.position = position;
	}

	public int getSalary() {
		return salary;
	}

	public void setSalary(int salary) {
		this.salary = salary;
	}

	public String getHire_date() {
		return hire_date;
	}

	public void setHire_date(String hire_date) {
		this.hire_date = hire_date;
	}

	public String getEmail() {
		return email;
	}

	public void setEmail(String email) {
		this.email = email;
	}

	@Override
	public String toString() {
		return "EmpDTO [emp_no=" + emp_no + ", emp_name=" + emp_name + ", dept=" + dept + ", position=" + position
				+ ", salary=" + salary + ", hire_date=" + hire_date + ", email=" + email + "]";
	}
	
}
	
	
