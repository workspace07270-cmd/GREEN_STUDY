<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>사원 관리</title>

<style>
	table{
		width:900px;
		margin: 30px auto;
		border-collapse: collapse;
		table-layout: fixed;
	}

	th, td{
		border:1px solid #333;
		padding:8px;
		text-align:center;
	}

	.btnDelete{
		background:red;
		color:white;
		border:none;
		padding:5px 10px;
		cursor:pointer;
	}

	.btnUpdate{
		background:blue;
		color:white;
		padding:5px 10px;
		text-decoration:none;
	}
</style>

<script>
function bindDelete(){
	document.querySelectorAll('.btnDelete').forEach(btn => {
		btn.onclick = () => {
			let emp_no = btn.parentElement.parentElement.firstElementChild.innerText;

			if(confirm(emp_no + " 삭제하시겠습니까?")){
				location.href = "./deleteEmp.do?emp_no=" + emp_no;
			}
		}
	});
}

window.onload = () => {
	bindDelete();

	// 검색 (전체 새로고침 방식)
	document.querySelector('#btnSearch').onclick = () => {

		let type = document.querySelector('#type').value;
		let keyword = document.querySelector('#keyword').value;

		location.href = "./empList.do?type=" + type + "&keyword=" + keyword;
	};
}
</script>

</head>

<body>

<h2 style="text-align:center;">사원 목록</h2>

<div style="text-align:center; margin-bottom:10px;">
	<a href="./insertForm.do">사원 등록</a>
</div>

<table>

	<thead>

		<tr>
			<td colspan="7">

				<select id="type">
					<option value="emp_name">이름</option>
					<option value="dept">부서</option>
					<option value="position">직급</option>
				</select>

				<input type="text" id="keyword" placeholder="검색어 입력">

				<button id="btnSearch">검색</button>

			</td>
		</tr>

		<tr>
			<th>사원번호</th>
			<th>이름</th>
			<th>부서</th>
			<th>직급</th>
			<th>급여</th>
			<th>입사일</th>
			<th>이메일</th>
			<th>관리</th>
		</tr>

	</thead>

	<tbody>

		<c:forEach items="${list}" var="emp">

			<tr>
				<td>${emp.emp_no}</td>
				<td>${emp.emp_name}</td>
				<td>${emp.dept}</td>
				<td>${emp.position}</td>
				<td>${emp.salary}</td>
				<td>${emp.hire_date}</td>
				<td>${emp.email}</td>

				<td>
					<button class="btnDelete">삭제</button>

					<a class="btnUpdate"
					   href="./updateForm.do?emp_no=${emp.emp_no}">
						수정
					</a>
				</td>
			</tr>

		</c:forEach>

	</tbody>

</table>

</body>
</html>