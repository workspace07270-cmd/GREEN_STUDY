-- ----------------------------------------------------------------
-- 1. 데이터베이스 생성
-- ----------------------------------------------------------------
CREATE DATABASE IF NOT EXISTS emp_db;

USE emp_db;


-- ----------------------------------------------------------------
-- 2. 테이블 생성 (기존 테이블이 있으면 삭제 후 재생성)
-- ----------------------------------------------------------------
DROP TABLE IF EXISTS emp;

CREATE TABLE emp (
  emp_no    INT          NOT NULL AUTO_INCREMENT  COMMENT '사원번호',
  emp_name  VARCHAR(50)  NOT NULL                 COMMENT '사원명',
  dept      VARCHAR(30)  NOT NULL                 COMMENT '부서명',
  position  VARCHAR(30)  NOT NULL                 COMMENT '직급',
  salary    INT          NOT NULL                 COMMENT '급여(원)',
  hire_date DATE         NOT NULL                 COMMENT '입사일',
  email     VARCHAR(100)                          COMMENT '이메일',
  PRIMARY KEY (emp_no),
  UNIQUE KEY uq_email (email)
);


