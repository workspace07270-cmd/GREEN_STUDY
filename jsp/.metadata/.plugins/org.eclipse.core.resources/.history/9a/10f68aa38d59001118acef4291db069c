package controller;

import java.io.IOException;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import service.EmpService;
import view.ModelAndView;

public class EmpListController implements Controller {

    @Override
    public ModelAndView execute(HttpServletRequest request, HttpServletResponse response)
            throws IOException {

        EmpService service = EmpService.getInstance();

        String empNoStr = request.getParameter("emp_no");

        // emp_no가 없거나 빈값이면 전체 조회
        if (empNoStr == null || empNoStr.trim().isEmpty()) {
            request.setAttribute("list", service.getList());
        } else {
            try {
                int empNo = Integer.parseInt(empNoStr);

                // 단건 조회 결과를 list에 넣는 방식 (뷰 재사용 위해)
                request.setAttribute("list", service.getOne(empNo));

            } catch (NumberFormatException e) {
                request.setAttribute("list", service.getList());
            }
        }

        return new ModelAndView("main", false);
    }
}