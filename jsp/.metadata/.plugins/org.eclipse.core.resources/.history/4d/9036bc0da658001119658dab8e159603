package controller;

import java.io.IOException;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import service.EmpService;
import view.ModelAndView;

public class EmpListController implements Controller {

    @Override
    public ModelAndView execute(HttpServletRequest request, HttpServletResponse response)
            throws IOException {

        EmpService service = EmpService.getInstance();

        String type = request.getParameter("type");
        String keyword = request.getParameter("keyword");

        if (keyword == null || keyword.trim().isEmpty()) {
            // 🔥 전체 조회
            request.setAttribute("list", service.getList());
        } else {
            // 🔥 검색 조회
            request.setAttribute("list", service.getList(type, keyword));
        }

        return new ModelAndView("main", false);
    }
}