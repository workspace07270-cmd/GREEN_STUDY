package service;

import config.DBManager;
import mapper.EmpMapper;

public class EmpService {
	private static EmpService instance = new EmpService();
	private EmpMapper mapper;
	
	public EmpService() {
		mapper = DBManager.getInstance().getSession().getMapper(EmpMapper.class);
	}
	
	public static EmpService getInstance() {
		if(instance == null)
			instance = new EmpService();
		return instance;
	}
	   // 전체 조회
    public List<EmpDTO> getList() {
        return mapper.getList();
    }

    // 단건 조회
    public EmpDTO getEmp(int emp_no) {
        return mapper.getEmp(emp_no);
    }

    // 등록
    public int insertEmp(EmpDTO dto) {
        return mapper.insertEmp(dto);
    }

    // 수정
    public int updateEmp(EmpDTO dto) {
        return mapper.updateEmp(dto);
    }

    // 삭제
    public int deleteEmp(int emp_no) {
        return mapper.deleteEmp(emp_no);
    }
	

}
