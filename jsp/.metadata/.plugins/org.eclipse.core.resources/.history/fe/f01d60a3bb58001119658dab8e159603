<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>사원 목록</title>

<style>
    body {
        font-family: Arial;
    }

    .container {
        width: 90%;
        margin: 30px auto;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        border: 1px solid #ccc;
        padding: 10px;
        text-align: center;
    }

    th {
        background-color: #f2f2f2;
    }

    a {
        text-decoration: none;
        margin: 0 5px;
    }

    .btn {
        padding: 6px 12px;
        background: #4CAF50;
        color: white;
        border: none;
        cursor: pointer;
    }

    .btn-delete {
        background: #e74c3c;
    }

    .btn-update {
        background: #3498db;
    }
</style>

</head>

<body>

<div class="container">

<h2>사원 목록</h2>

<!-- 🔥 상단 버튼 + 검색 -->
<div class="top-bar">

    <!-- 추가 버튼 -->
    <div>
        <a href="emp_write_form.do">
            <button class="btn">사원 등록</button>
        </a>
    </div>

    <!-- 검색 -->
    <div>
        <form action="emp_list.do" method="get">
            <select name="type">
                <option value="emp_name">이름</option>
                <option value="dept">부서</option>
                <option value="position">직급</option>
            </select>

            <input type="text" name="keyword" placeholder="검색어 입력">

            <button class="btn">검색</button>
        </form>
    </div>

</div>

<!-- 테이블 -->
<table>
    <tr>
        <th>사원번호</th>
        <th>이름</th>
        <th>부서</th>
        <th>직급</th>
        <th>급여</th>
        <th>입사일</th>
        <th>이메일</th>
        <th>관리</th>
    </tr>

    <c:forEach var="emp" items="${list}">
        <tr>
            <td>${emp.emp_no}</td>
            <td>${emp.emp_name}</td>
            <td>${emp.dept}</td>
            <td>${emp.position}</td>
            <td>${emp.salary}</td>
            <td>${emp.hire_date}</td>
            <td>${emp.email}</td>
            <td>
                <a href="updateForm.do?emp_no=${emp.emp_no}">
                    <button class="btn btn-update">수정</button>
                </a>

                <a href="delete.do?emp_no=${emp.emp_no}"
                   onclick="return confirm('삭제하시겠습니까?');">
                    <button class="btn btn-delete">삭제</button>
                </a>
            </td>
        </tr>
    </c:forEach>

</table>

</div>

</body>
</html>