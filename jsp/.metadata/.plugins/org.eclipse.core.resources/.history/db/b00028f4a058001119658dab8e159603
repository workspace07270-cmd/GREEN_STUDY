package controller;

import java.io.IOException;

import dto.EmpDTO;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import service.EmpService;
import view.ModelAndView;

public class EmpUpdateFormController implements Controller {

    @Override
    public ModelAndView execute(HttpServletRequest request, HttpServletResponse response)
            throws IOException {

        // 1. emp_no 받기
        int emp_no = Integer.parseInt(request.getParameter("emp_no"));

        // 2. 단건 조회
        EmpService service = EmpService.getInstance();
        EmpDTO dto = service.getEmp(emp_no);

        // 3. request에 담기 (JSP에서 사용할 데이터)
        request.setAttribute("emp", dto);

        // 4. 수정 페이지로 이동 (forward)
        return new ModelAndView("emp_update", false);
    }
}