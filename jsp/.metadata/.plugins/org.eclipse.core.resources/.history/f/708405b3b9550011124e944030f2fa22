<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>사원 등록</title>

<style>
    table {
        margin: 50px auto;
        border-collapse: collapse;
    }

    td {
        padding: 10px;
    }

    input {
        width: 200px;
        padding: 5px;
    }

    .btn {
        padding: 8px 15px;
        cursor: pointer;
    }
</style>

</head>

<body>

<h2 style="text-align:center;">사원 등록</h2>

<form action="emp_write.do" method="post">

<table border="1">

    <tr>
        <td>이름</td>
        <td><input type="text" name="emp_name" required></td>
    </tr>

    <tr>
        <td>부서</td>
        <td><input type="text" name="dept" required></td>
    </tr>

    <tr>
        <td>직급</td>
        <td><input type="text" name="position" required></td>
    </tr>

    <tr>
        <td>급여</td>
        <td><input type="number" name="salary" required></td>
    </tr>

    <tr>
        <td>입사일</td>
        <td><input type="date" name="hire_date" required></td>
    </tr>

    <tr>
        <td>이메일</td>
        <td><input type="email" name="email"></td>
    </tr>

    <tr>
        <td colspan="2" style="text-align:center;">
            <input type="submit" value="등록" class="btn">
            <input type="reset" value="초기화" class="btn">
        </td>
    </tr>

</table>

</form>

</body>
</html>